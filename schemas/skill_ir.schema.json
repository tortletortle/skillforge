{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillforge.local/schemas/skill-ir-0.1.schema.json",
  "title": "SKILLFORGE Skill IR 0.1",
  "type": "object",
  "required": ["schema_version", "id", "version", "name", "inputs", "outputs", "steps", "output_map"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "inputs": {"$ref": "#/$defs/typeMap"},
    "outputs": {"$ref": "#/$defs/typeMap"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "output_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ref"}},
    "preconditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
    "postconditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
    "tests": {"type": "array", "items": {"type": "object", "required": ["input", "expected"], "properties": {"name": {"type": "string"}, "input": {"type": "object"}, "expected": {"type": "object"}}}},
    "properties": {"type": "array", "items": {"type": "object", "required": ["kind"]}},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true,
  "$defs": {
    "typeName": {"enum": ["string", "integer", "number", "boolean", "object", "array", "any"]},
    "typeMap": {"type": "object", "additionalProperties": {"$ref": "#/$defs/typeName"}},
    "ref": {"type": "object", "required": ["$ref"], "properties": {"$ref": {"type": "string", "pattern": "^(input|step)\\.[A-Za-z_][A-Za-z0-9_-]*$"}}, "additionalProperties": false},
    "step": {"type": "object", "required": ["id", "op", "args"], "properties": {"id": {"type": "string", "minLength": 1}, "op": {"type": "string"}, "args": {"type": "object"}}, "additionalProperties": false},
    "condition": {"type": "object", "required": ["path", "op"], "properties": {"path": {"type": "string"}, "op": {"enum": ["non_empty", "is_type", "eq", "ne", "gte", "lte", "contains", "lowercase", "no_whitespace"]}, "value": {}}, "additionalProperties": false}
  }
}
